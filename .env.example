VITE_NETWORK=mainnet
VITE_TON_ENDPOINT=
VITE_TONCENTER_API_KEY=
VITE_TONCONNECT_MANIFEST_URL=

# Solana network: devnet (default) or mainnet.
VITE_SOLANA_NETWORK=devnet

# Your own RPC for Solana instead of the public one.
VITE_SOLANA_RPC=

# WalletConnect project id — without it this connection method
# doesn't work. Free at dashboard.reown.com, registration takes a minute.
# It's public by design: it ends up in the bundle and is visible to all.
VITE_WALLETCONNECT_PROJECT_ID=

# HyperEVM node. Optional: the public rpc.hyperliquid.xyz/evm works even
# from the browser, unlike the public Solana node.
VITE_HYPEREVM_RPC=
