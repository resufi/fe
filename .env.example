VITE_NETWORK=mainnet
VITE_TONCONNECT_MANIFEST_URL=https://raw.githubusercontent.com/resufi/tonconnect-meta/refs/heads/main/tonconnect-manifest.json
VITE_TONCENTER_API_KEY=your_key_from_toncenter_bot
# Optional: override the TON RPC endpoint (defaults to the built-in toncenter URL)
VITE_TON_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_from_walletconnect
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC=your_rpc
# Optional: override the HyperEVM RPC endpoint (defaults to the built-in URL)
VITE_HYPEREVM_RPC=https://rpc.hyperliquid.xyz/evm
