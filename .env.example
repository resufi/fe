# Сеть: testnet (по умолчанию) или mainnet.
# Определяет, какой файл из src/deployments/ читать.
VITE_NETWORK=testnet

# RPC-эндпоинт. Если не задан — используется публичный ton-access.
#
# ПОЧЕМУ ЭТО ВАЖНО: ton-access балансирует запросы между узлами, и среди них
# попадаются отставшие. На проверке он вернул `uninitialized` и баланс 494 GRAM
# для контракта, который на самом деле active с 80 197 GRAM. Для интерфейса это
# означает выдуманные балансы и «позиции нет» там, где она есть.
#
# На продакшене задавайте свой узел или toncenter с ключом.
VITE_TON_ENDPOINT=

# Ключ toncenter. Без него лимит около одного запроса в секунду, и интерфейс
# обновляется медленно (запросы идут по очереди, чтобы не ловить ошибки).
# Бесплатный ключ выдаёт бот @tonapibot.
VITE_TONCENTER_API_KEY=

# Публичный https-адрес манифеста TonConnect.
#
# Кошелёк скачивает манифест сам, со своего устройства, поэтому localhost он
# НЕ ВИДИТ и отвечает «invalid manifest». Для локальной разработки положите
# public/tonconnect-manifest.json на любой публичный https и укажите ссылку
# здесь — например raw.githubusercontent.com или туннель (ngrok, cloudflared).
# В продакшене оставьте пустым: сработает путь по умолчанию.
VITE_TONCONNECT_MANIFEST_URL=
